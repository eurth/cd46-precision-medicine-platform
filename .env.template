# LLM APIs
# OpenRouter Gemma (primary for auto mode) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional override (default: openrouter/google/gemma-4-31b-it:free)
# OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it:free
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
# Research Assistant daily LLM call cap (UTC day; default 40)
# LLM_DAILY_CAP=40

# AuraDB Free (Neo4j)
# Create free account at: https://neo4j.com/cloud/platform/aura-graph-database/
# Or: python scripts/create_aura_instance.py --update-env  (needs AURA_CLIENT_ID/SECRET)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_auradb_password_here

# Aura API (optional — create Free instance programmatically)
# Aura Console → profile → Account details → API credentials
# AURA_CLIENT_ID=
# AURA_CLIENT_SECRET=
# AURA_TENANT_ID=2a7764af-08bb-4fcc-aeab-396b2e27aa1a

# Synapse (AACR GENIE — PHASE 2 ONLY)
# Get token from: https://accounts.synapse.org/Profile:profile/settings
SYNAPSE_AUTH_TOKEN=your_synapse_personal_access_token_here

# PubMed (Entrez)
ENTREZ_EMAIL=your_email@institution.edu

# Optional: LangSmith tracing
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=cd46-platform
